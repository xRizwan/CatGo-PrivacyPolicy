  .ev-ghost { position: absolute; left: 6%; top: 14%; width: 26%; animation: float 3s ease-in-out infinite; }
  .ev-candy { position: absolute; left: 24%; bottom: 14%; width: 15%; animation: wiggle 1.4s ease-in-out infinite; }
  @media (max-width: 760px) { .event-card { grid-template-columns: 1fr; } .event-copy { padding: 28px 24px 0; } .event-art { min-height: 230px; } }

  /* ---------- FAQ ---------- */
  .faq { background: var(--cream-2); border-top: 5px solid var(--ink); }
