  .cta-row { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 4px; }
  .stats { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stats li { display: flex; align-items: center; gap: 6px; font-size: 15px; background: #fff; border: 3px solid var(--ink); border-radius: 16px; padding: 4px 14px 4px 6px; box-shadow: 0 4px 0 var(--ink); animation: bob 3s ease-in-out infinite; animation-delay: var(--d); }
  .stats img { width: 36px; height: 36px; object-fit: contain; }
