  .ground-pets { display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 30px; }
  .ground-pets img { width: 110px; height: 90px; object-fit: contain; animation: squish 1.6s ease-in-out infinite; animation-delay: var(--d); transform-origin: 50% 100%; }

  /* ---------- Story ---------- */
  .comic { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 26px; max-width: 1000px; margin-inline: auto; counter-reset: p; }
  .panel { background: #fff; border: 5px solid var(--ink); border-radius: 18px; box-shadow: 0 8px 0 var(--ink); overflow: hidden; transform: rotate(var(--tilt)); transition-delay: var(--d); }
  .panel.in { transform: rotate(var(--tilt)); }
  .panel img { border-bottom: 4px solid var(--ink); }
  .panel p { padding: 12px 18px 14px; font: 400 21px/1.25 var(--display); }
  @media (max-width: 700px) { .comic { grid-template-columns: 1fr; } }

  /* ---------- Style ---------- */
  .style-sec { background: linear-gradient(135deg, #ffd6e2, #ffe9c7); border-block: 5px solid var(--ink); }
  .style-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: center; }
  .style-grid h2 { margin-bottom: 14px; }
  .lead { font-size: 20px; color: var(--ink-soft); }
  .style-items { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
  .style-items span { aspect-ratio: 1; display: grid; place-items: center; background: #fff; border: 4px solid var(--ink); border-radius: 18px; box-shadow: 0 5px 0 var(--ink); animation: bob 2.6s ease-in-out infinite; animation-delay: var(--d); }
  .style-items img { width: 72%; height: 72%; object-fit: contain; }
  @media (max-width: 860px) { .style-grid { grid-template-columns: 1fr; text-align: center; } .style-items { grid-template-columns: repeat(4, 1fr); } }

  /* ---------- Modes ---------- */
  .mode-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .mode { background: #fff; border: 4px solid var(--ink); border-radius: var(--radius); box-shadow: 0 7px 0 var(--ink); padding: 24px; display: grid; gap: 8px; justify-items: center; text-align: center; transition-delay: var(--d); }
  .mode img { width: 84px; height: 84px; object-fit: contain; animation: wiggle 3s ease-in-out infinite; }
  .mode p { color: var(--ink-soft); }
  @media (max-width: 800px) { .mode-list { grid-template-columns: 1fr; } }

  /* ---------- Event ---------- */
