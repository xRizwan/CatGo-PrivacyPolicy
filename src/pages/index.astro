---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import AutoRun from '../components/AutoRun.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PLAY_ICON as playIcon } from '../components/play-icon';
import copy from '../data/copy.json';

type Glob = Record<string, ImageMetadata>;
const g = {
  heroes: import.meta.glob<ImageMetadata>('../assets/heroes/*.png', { eager: true, import: 'default' }),
  bosses: import.meta.glob<ImageMetadata>('../assets/bosses/*.png', { eager: true, import: 'default' }),
  pets: import.meta.glob<ImageMetadata>('../assets/pets/*.png', { eager: true, import: 'default' }),
  cards: import.meta.glob<ImageMetadata>('../assets/cards/*.png', { eager: true, import: 'default' }),
  ui: import.meta.glob<ImageMetadata>('../assets/ui/*.png', { eager: true, import: 'default' }),
  bg: import.meta.glob<ImageMetadata>('../assets/bg/*.png', { eager: true, import: 'default' }),
  shots: import.meta.glob<ImageMetadata>('../assets/shots/*.png', { eager: true, import: 'default' }),
  story: import.meta.glob<ImageMetadata>('../assets/story/*.png', { eager: true, import: 'default' }),
  style: import.meta.glob<ImageMetadata>('../assets/style/*.png', { eager: true, import: 'default' }),
  fly: import.meta.glob<ImageMetadata>('../assets/fly/*.png', { eager: true, import: 'default' }),
  enemies: import.meta.glob<ImageMetadata>('../assets/enemies/*.png', { eager: true, import: 'default' }),
};
const pick = (glob: Glob, name: string) => {
  const key = Object.keys(glob).find((k) => k.endsWith(`/${name}.png`));
  if (!key) throw new Error(`missing art: ${name}`);
  return glob[key];
};
const url = async (src: ImageMetadata, width: number, format: 'webp' | 'png' = 'webp') =>
  (await getImage({ src, width, format })).src;

const PLAY = 'https://play.google.com/store/apps/details?id=com.xoproductions.catgo';
const SITE = 'https://catgo.xoproduction.com';
const EMAIL = 'xo.labs.production@gmail.com';

// Hero roster and perks as they are in LaneCats.cs.
const heroes = [
  { id: 'ginger', name: 'Ginger', perk: 'The original hero' },
  { id: 'smokey', name: 'Smokey', perk: 'Starts with a dagger' },
  { id: 'midnight', name: 'Midnight', perk: 'Attacks 15% faster' },
  { id: 'snowball', name: 'Snowball', perk: '+25% coins' },
  { id: 'calico', name: 'Calico', perk: 'Starts with a pet' },
  { id: 'bao', name: 'Bao', perk: 'Red panda. Starts with a crossbow' },
  { id: 'mochi', name: 'Chef Mochi', perk: '+25% power from every kill and card' },
  { id: 'whiskers', name: 'Capt. Whiskers', perk: 'Starts with a sword. +15% power from every kill' },
  { id: 'pip', name: 'Pip', perk: 'Penguin. Starts with a fire wave and a pet' },
];

const worldArt = [
  { bg: 'bg_forest', who: pick(g.bosses, 'boss_ogre'), whoName: 'Ogre King', color: '#5fbf4a' },
  { bg: 'bg_volcano', who: pick(g.bosses, 'boss_orc'), whoName: 'Orc Chief', color: '#ff7a3d' },
  { bg: 'bg_dragon', who: pick(g.pets, 'pet_dragon'), whoName: 'A baby dragon', color: '#9b7bf0' },
  { bg: 'bg_frost', who: pick(g.bosses, 'boss_yeti'), whoName: 'Yeti King', color: '#5aaef0' },
  { bg: 'bg_desert', who: pick(g.bosses, 'boss_sphinx'), whoName: 'Sphinx King', color: '#e9b33c' },
  { bg: 'bg_reef', who: pick(g.bosses, 'boss_kraken'), whoName: 'Kraken', color: '#2fb8b0' },
];
const worlds = copy.worlds.items.map((w, i) => ({ ...w, ...worldArt[i], bgImg: pick(g.bg, worldArt[i].bg) }));

const shotAlts = [
  'Cat Go! home screen in the Sunken Reef with Ginger, a pet pig and a puffer fish',
  'Picking the right lane in Magma Falls while skeletons walk toward the cat',
  'Stacked weapons: fire waves, daggers and bolts hitting enemies in Cloud Gardens',
  'Boss fight against an orc chief with 119K power',
  'A sandstorm tornado sweeping two lanes in the Desert Dunes',
  'Pick a power-up screen: Quick Paws, Pet Wyvern or Power Up',
  'Heroes screen with Ginger, Smokey, Midnight, Snowball and Calico',
  'The six worlds of Cat Go! side by side, each with its boss',
];
const shotTitles = ['A cat adventure awaits', 'Pick the right lane', 'Stack every weapon', 'Beat the boss', 'Summon a sandstorm', 'Choose your power-up', 'Collect heroes', 'Explore new worlds'];
const shots = Object.keys(g.shots).sort().map((k, i) => ({ src: g.shots[k], alt: shotAlts[i], title: shotTitles[i] }));

// The first comic, captions as in LaneStory.cs.
const storyCaps = [
  'Ginger had ONE job: guard the legendary Golden Tuna.',
  'He took a nap. Just a tiny one. Meanwhile...',
  'NOT. THE. TUNA!!!',
  'This means war. (Right after breakfast.)',
];
const story = Object.keys(g.story).sort().map((k, i) => ({ src: g.story[k], cap: storyCaps[i] }));

const cardNames = ['dagger', 'crossbow', 'sword', 'fire', 'bomb', 'boomerang', 'ice', 'staff', 'sandstorm', 'trident', 'lizard', 'salamander', 'wyvern', 'owlet', 'scarab', 'puffer', 'pig', 'poop'];
const cards = cardNames.map((n) => ({ n, src: pick(g.cards, `icon_${n}`) }));

const flyNames = ['dragon', 'wyvern', 'snowowl', 'stormdrake', 'seadragon', 'puffer', 'lavapup', 'goldscarab'];
const flyers = await Promise.all(
  flyNames.map(async (n) => {
    const src = pick(g.fly, n);
    const frameW = Math.round(src.width / 4);
    return { n, url: await url(src, src.width, 'webp'), w: Math.round((frameW * 110) / src.height) };
  }),
);
const groundPets = ['pet_lizard', 'pet_salamander', 'pet_owlet', 'pet_scarab', 'mount_pig'].map((n) => pick(g.pets, n));

const styleItems = ['skin_fish', 'skin_banana', 'skin_carrot', 'skin_watermelon', 'skin_popsicle', 'skin_golddagger', 'trail_heart', 'trail_rainbow', 'trail_star', 'trail_paw', 'trail_note', 'trail_bubble'].map((n) => pick(g.style, n));

const parade = ['enemy_goblin', 'enemy_skeleton', 'enemy_brute', 'enemy_reaper', 'enemy_reef_crab', 'enemy_reef_jelly', 'enemy_snow_penguin', 'enemy_sand_cactus', 'enemy_hw_ghost', 'enemy_hw_lantern'].map((n) => pick(g.enemies, n));

// One chapter of the power climb. The numbers are illustrative, the rules are the game's:
// weapon cards add, eaten enemies add their power, mounts multiply, poop halves.
const climbArt = [
  pick(g.heroes, 'ginger'), pick(g.cards, 'icon_dagger'), pick(g.enemies, 'enemy_goblin'), pick(g.cards, 'icon_poop'), pick(g.enemies, 'enemy_skeleton'),
  pick(g.pets, 'mount_pig'), pick(g.pets, 'pet_lizard'), pick(g.enemies, 'enemy_brute'), pick(g.bosses, 'boss_ogre'),
];
const climb = copy.climb.steps.map((s, i) => ({ ...s, art: climbArt[i] }));
const runArt = {
  hero: await url(pick(g.heroes, 'ginger'), 300),
  pig: await url(pick(g.pets, 'mount_pig'), 300),
  pet: await url(pick(g.pets, 'pet_lizard'), 200),
  paw: await url(pick(g.ui, 'guide_paw'), 140),
  shot: await url(pick(g.cards, 'icon_dagger'), 80),
  goblin: await url(pick(g.enemies, 'enemy_goblin'), 220),
  skeleton: await url(pick(g.enemies, 'enemy_skeleton'), 220),
  brute: await url(pick(g.enemies, 'enemy_brute'), 260),
  reaper: await url(pick(g.enemies, 'enemy_reaper'), 260),
  boss: await url(pick(g.bosses, 'boss_ogre'), 420),
  cardDagger: await url(pick(g.cards, 'icon_dagger'), 120),
  cardPoop: await url(pick(g.cards, 'icon_poop'), 120),
  cardCrossbow: await url(pick(g.cards, 'icon_crossbow'), 120),
  cardPig: await url(pick(g.cards, 'icon_pig'), 120),
  cardLizard: await url(pick(g.cards, 'icon_lizard'), 120),
  trees: await url(pick(g.bg, 'bg_forest'), 1095),
  road: await url(pick(g.bg, 'bg_path'), 1600),
};

const stepArt = [pick(g.ui, 'guide_paw'), pick(g.ui, 'icon_power'), pick(g.cards, 'icon_sword'), pick(g.bosses, 'boss_ogre')];
const modeArt = [pick(g.ui, 'icon_rank_endless'), pick(g.ui, 'icon_rank_daily'), pick(g.ui, 'icon_ranks')];
const statArt = [pick(g.ui, 'icon_map'), pick(g.ui, 'icon_chest'), pick(g.ui, 'icon_heroes'), pick(g.pets, 'pet_wyvern')];

const ogImage = `${SITE}/og-image.jpg`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE}/#org`,
    name: 'XO Productions',
    alternateName: 'XO Labs',
    url: 'https://xoproduction.com',
    email: EMAIL,
    logo: `${SITE}/icon.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    name: 'Cat Go!',
    url: `${SITE}/`,
    publisher: { '@id': `${SITE}/#org` },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': ['VideoGame', 'MobileApplication'],
    '@id': `${SITE}/#game`,
    name: 'Cat Go!',
    alternateName: 'Cat Go',
    description: copy.what.body[0],
    url: `${SITE}/`,
    image: ogImage,
    screenshot: shots.map((s) => `${SITE}${s.src.src}`),
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Casual / Action',
    genre: ['Casual', 'Action', 'Lane runner'],
    gamePlatform: 'Android',
    operatingSystem: 'Android',
    playMode: 'SinglePlayer',
    numberOfPlayers: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 1 },
    installUrl: PLAY,
    sameAs: [PLAY],
    inLanguage: 'en',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: PLAY },
    character: heroes.map((h) => ({ '@type': 'Thing', name: h.name, description: h.perk })),
    author: { '@id': `${SITE}/#org` },
    publisher: { '@id': `${SITE}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faq.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

---
<Layout jsonLd={jsonLd}>
  <SiteHeader />

  <!-- ===== Header ===== -->

  <main>
    <!-- ===== Hero ===== -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="sky" aria-hidden="true">
        <svg class="cloud c1"><use href="#cloud" /></svg>
        <svg class="cloud c2"><use href="#cloud" /></svg>
        <svg class="cloud c3"><use href="#cloud" /></svg>
        <div class="sun"></div>
      </div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <Image class="hero-logo" src={pick(g.ui, 'logo_catgo')} alt="Cat Go! logo" width={420} loading="eager" fetchpriority="high" />
          <h1 id="hero-title">{copy.hero.h1}</h1>
          <p class="hero-sub">{copy.hero.sub}</p>
          <div class="cta-row">
            <a class="btn" href={PLAY} rel="noopener"><Fragment set:html={playIcon} /><span><small>Android</small>{copy.hero.cta}</span></a>
            <a class="btn purple" href="#climb">{copy.hero.cta2}</a>
          </div>
          <ul class="stats">
            {copy.hero.stats.map((s, i) => (
              <li style={`--d:${i * 0.12}s`}>
                <Image src={statArt[i]} alt="" width={56} />
                <span><b>{s.n}</b> {s.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-stage" aria-hidden="true">
          <div class="stage-ring"></div>
          <div class="power-bubble"><span>⚡</span><b data-count>1</b></div>
          <Image class="stage-cat" src={pick(g.ui, 'guide_wave')} alt="" width={420} loading="eager" />
          <Image class="orbit o1" src={pick(g.cards, 'icon_sword')} alt="" width={96} />
          <Image class="orbit o2" src={pick(g.cards, 'icon_fire')} alt="" width={96} />
          <Image class="orbit o3" src={pick(g.cards, 'icon_crossbow')} alt="" width={96} />
          <Image class="orbit o4" src={pick(g.cards, 'icon_bomb')} alt="" width={96} />
          <div class="dream">
            <span class="puff p1"></span><span class="puff p2"></span>
            <div class="dream-cloud"><Image src={pick(g.ui, 'golden_tuna')} alt="" width={260} /></div>
          </div>
          <Image class="stage-pet" src={pick(g.pets, 'pet_wyvern')} alt="" width={150} />
          <Image class="stage-pig" src={pick(g.pets, 'mount_pig')} alt="" width={150} />
          {[0, 1, 2, 3, 4, 5].map((i) => <svg class={`spark s${i}`}><use href="#sparkle" /></svg>)}
        </div>
      </div>

      <div class="parade" aria-hidden="true">
        <div class="parade-track">
          {[...parade, ...parade].map((src) => <Image src={src} alt="" width={90} />)}
        </div>
      </div>
      <svg class="hill" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 50 C 240 0 420 100 720 60 S 1200 10 1440 50 V120 H0z" fill="var(--cream)" stroke="var(--ink)" stroke-width="5" />
      </svg>
    </section>

    <!-- ===== Story ===== -->
    <section class="section story" id="story" aria-labelledby="story-title">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="chip">{copy.story.chip}</span>
          <h2 id="story-title">{copy.story.title}</h2>
          <p>{copy.story.sub}</p>
        </div>
        <ol class="comic">
          {story.map((s, i) => (
            <li class="panel reveal" style={`--d:${i * 0.12}s; --tilt:${[-1.5, 1, -0.8, 1.6][i]}deg`}>
              <Image src={s.src} alt={s.cap} widths={[400, 700]} sizes="(max-width: 700px) 92vw, 520px" width={1600} height={900} />
              <p>{s.cap}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== Power climb ===== -->
    <section class="section climb-sec" id="climb" aria-labelledby="climb-title">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="chip">{copy.climb.chip}</span>
          <h2 id="climb-title">{copy.climb.title}</h2>
          <p>{copy.climb.sub}</p>
        </div>
        <div class="climb reveal" data-climb>
          <AutoRun art={runArt} notes={climb.map((c) => c.note)} label={copy.climb.label} />
          <ol class="moments">
            {climb.map((s, i) => (
              <li class={`moment ${s.bad ? 'bad' : ''} ${i === climb.length - 1 ? 'boss' : ''}`}>
                <span class="m-art"><Image src={s.art} alt="" width={140} /></span>
                <span class="m-title">{s.title}</span>
                <span class="m-power">{s.label}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ===== How it plays ===== -->
    <section class="section how" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="how-title">{copy.how.title}</h2>
          <p>{copy.how.sub}</p>
        </div>
        <ol class="steps">
          {copy.how.steps.map((s, i) => (
            <li class="step reveal" style={`--d:${i * 0.1}s`}>
              <span class="step-n">{i + 1}</span>
              <Image src={stepArt[i]} alt="" width={140} />
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== Worlds ===== -->
    <section class="section worlds" id="worlds" aria-labelledby="worlds-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="worlds-title">{copy.worlds.title}</h2>
          <p>{copy.worlds.sub}</p>
        </div>
        <ol class="world-list">
          {worlds.map((w, i) => (
            <li class="world reveal" style={`--c:${w.color}; --d:${(i % 3) * 0.1}s`}>
              <div class="world-bg">
                <Image src={w.bgImg} alt="" width={560} />
                <Image class="world-who" src={w.who} alt={w.whoName} width={190} />
              </div>
              <div class="world-copy">
                <span class="world-ch">{w.chapters}</span>
                <h3>{w.name}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== Heroes ===== -->
    <section class="section heroes" id="heroes" aria-labelledby="heroes-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="heroes-title">{copy.heroes.title}</h2>
          <p>{copy.heroes.sub}</p>
        </div>
        <ul class="hero-cards">
          {heroes.map((h, i) => (
            <li class="hero-card reveal" style={`--d:${(i % 3) * 0.08}s; --tilt:${(i % 2 ? 1 : -1) * 1.5}deg`}>
              <div class="hc-art">
                <Image src={pick(g.heroes, h.id)} alt={`${h.name}, a Cat Go! hero`} width={200} />
              </div>
              <h3>{h.name}</h3>
              <p>{h.perk}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Weapons ===== -->
    <section class="section weapons" aria-labelledby="weapons-title">
      <div class="wrap section-head reveal">
        <h2 id="weapons-title">{copy.weapons.title}</h2>
        <p>{copy.weapons.sub}</p>
      </div>
      <div class="card-belt" aria-hidden="true">
        <div class="belt-track">
          {[...cards, ...cards].map((c) => <span class="card"><Image src={c.src} alt="" width={110} /></span>)}
        </div>
      </div>
      <div class="card-belt reverse" aria-hidden="true">
        <div class="belt-track">
          {[...cards.slice().reverse(), ...cards.slice().reverse()].map((c) => <span class="card"><Image src={c.src} alt="" width={110} /></span>)}
        </div>
      </div>
      <ul class="sr-only">{cards.map((c) => <li>{c.n} card</li>)}</ul>
    </section>

    <!-- ===== Pets ===== -->
    <section class="section pets" aria-labelledby="pets-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="pets-title">{copy.pets.title}</h2>
          <p>{copy.pets.sub}</p>
        </div>
        <div class="flyers" aria-hidden="true">
          {flyers.map((f, i) => (
            <span class="flyer" style={`--sheet:url(${f.url}); --w:${f.w}px; --d:${(i * 0.37).toFixed(2)}s`}></span>
          ))}
        </div>
        <div class="ground-pets" aria-hidden="true">
          {groundPets.map((src, i) => <Image src={src} alt="" width={130} style={`--d:${i * 0.2}s`} />)}
        </div>
      </div>
    </section>

    <!-- ===== Screenshots ===== -->
    <section class="section shots" aria-labelledby="shots-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="shots-title">{copy.shots.title}</h2>
          {copy.shots.sub && <p>{copy.shots.sub}</p>}
        </div>
      </div>
      <div class="shot-strip-wrap reveal">
        <button class="strip-btn prev" type="button" aria-label="Previous screenshots" data-strip="-1">‹</button>
        <ul class="shot-strip" data-strip-el>
          {shots.map((s) => (
            <li>
              <figure>
                <Image src={s.src} alt={s.alt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 86vw, 640px" width={1920} height={1080} />
                <figcaption class="sr-only">{s.title}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <button class="strip-btn next" type="button" aria-label="Next screenshots" data-strip="1">›</button>
      </div>
    </section>

    <!-- ===== Style shop ===== -->
    <section class="section style-sec" aria-labelledby="style-title">
      <div class="wrap style-grid">
        <div class="reveal">
          <h2 id="style-title">{copy.style.title}</h2>
          <p class="lead">{copy.style.sub}</p>
        </div>
        <div class="style-items reveal" aria-hidden="true">
          {styleItems.map((src, i) => <span style={`--d:${(i * 0.23).toFixed(2)}s`}><Image src={src} alt="" width={84} /></span>)}
        </div>
      </div>
    </section>

    <!-- ===== Modes ===== -->
    <section class="section modes" aria-labelledby="modes-title">
      <div class="wrap">
        <div class="section-head reveal"><h2 id="modes-title">{copy.modes.title}</h2></div>
        <ul class="mode-list">
          {copy.modes.items.map((m, i) => (
            <li class="mode reveal" style={`--d:${i * 0.1}s`}>
              <Image src={modeArt[i]} alt="" width={96} />
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Halloween event ===== -->
    <section class="event" aria-labelledby="event-title">
      <div class="wrap event-card reveal">
        <Image class="event-bg" src={pick(g.bg, 'bg_halloween')} alt="" width={1100} />
        <div class="event-copy">
          <span class="chip">🎃 {copy.event.badge}</span>
          <h2 id="event-title">{copy.event.title}</h2>
          <p>{copy.event.text}</p>
        </div>
        <div class="event-art" aria-hidden="true">
          <Image class="ev-boss" src={pick(g.bosses, 'boss_pumpkin')} alt="" width={260} />
          <Image class="ev-ghost" src={pick(g.enemies, 'enemy_hw_ghost')} alt="" width={110} />
          <Image class="ev-candy" src={pick(g.ui, 'icon_candy')} alt="" width={70} />
        </div>
      </div>
    </section>

    <!-- ===== What is it (definition block for answer engines) ===== -->
    <section class="section what" aria-labelledby="what-title">
      <div class="wrap what-grid reveal">
        <Image class="what-cat" src={pick(g.ui, 'guide_gift')} alt="Ginger the orange cat holding a gift" width={300} />
        <div class="what-copy">
          <h2 id="what-title">{copy.what.title}</h2>
          {copy.what.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section faq" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq-wrap">
        <div class="section-head reveal"><h2 id="faq-title">{copy.faq.title}</h2></div>
        <div class="faq-list">
          {copy.faq.items.map((f, i) => (
            <details class="reveal" open={i === 0}>
              <summary><h3>{f.q}</h3><span class="plus" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Final CTA ===== -->
    <section class="final" aria-labelledby="final-title">
      <div class="wrap final-card reveal">
        <Image class="final-cat" src={pick(g.ui, 'guide_cheer')} alt="Ginger cheering" width={260} />
        <div>
          <h2 id="final-title">{copy.cta.title}</h2>
          <p>{copy.cta.text}</p>
          <a class="btn" href={PLAY} rel="noopener"><Fragment set:html={playIcon} /><span><small>Android</small>{copy.cta.button}</span></a>
        </div>
        <Image class="final-boss" src={pick(g.bosses, 'boss_crabking')} alt="" width={200} />
      </div>
    </section>
  
  </main>

  <SiteFooter />

</Layout>

<style>

  /* ---------- Hero ---------- */
