  .hero-stage { position: relative; aspect-ratio: 1; max-width: 520px; justify-self: center; width: 100%; }
  .stage-ring { position: absolute; inset: 10%; border-radius: 50%; background: radial-gradient(circle, #fff7d6 0 45%, #ffe38a 46% 60%, transparent 61%); border: 5px dashed rgba(61, 38, 20, .25); animation: spin 40s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg) } }
  .stage-cat { position: absolute; left: 50%; top: 52%; width: 62%; transform: translate(-50%, -50%); animation: catbob 2.4s ease-in-out infinite; filter: drop-shadow(0 14px 0 rgba(61, 38, 20, .15)); }
  @keyframes catbob { 0%, 100% { transform: translate(-50%, -50%) } 50% { transform: translate(-50%, -54%) rotate(-2deg) } }
  .power-bubble { position: absolute; left: 50%; top: 4%; transform: translateX(-50%); z-index: 3; display: flex; align-items: center; gap: 6px; background: var(--green); border: 4px solid var(--ink); border-radius: 20px; padding: 6px 18px 8px; box-shadow: 0 5px 0 var(--ink); animation: bob 2.4s ease-in-out infinite; }
  .power-bubble b { font: 400 40px/1 var(--display); color: #fff; -webkit-text-stroke: 4px var(--ink); paint-order: stroke fill; min-width: 3ch; text-align: center; }
  .power-bubble span { font-size: 26px; }
  .orbit { position: absolute; width: 17%; filter: drop-shadow(0 6px 0 rgba(61, 38, 20, .2)); animation: float 4s ease-in-out infinite; }
  .o1 { left: 2%; top: 24%; } .o2 { right: 2%; top: 20%; animation-delay: -1s; } .o3 { left: 6%; bottom: 14%; animation-delay: -2s; }
  .o4 { right: 4%; bottom: 22%; animation-delay: -3s; }
  .stage-pet { position: absolute; right: 4%; top: 0; width: 21%; animation: float 3.2s ease-in-out infinite; animation-delay: -1.2s; }
  .o2 { top: 26%; }
  /* Ginger dreaming of the Tuna */
  .dream { position: absolute; left: -2%; top: -2%; width: 38%; z-index: 2; }
  .dream-cloud { position: relative; background: #fff; border: 4px solid var(--ink); border-radius: 50% 46% 52% 44% / 56% 50% 50% 46%; padding: 20% 14%; box-shadow: 0 5px 0 var(--ink); animation: bob 3.4s ease-in-out infinite; }
  .dream-cloud img { width: 100%; animation: wiggle 2.6s ease-in-out infinite; filter: drop-shadow(0 0 10px rgba(255, 200, 40, .7)); }
  .puff { position: absolute; background: #fff; border: 4px solid var(--ink); border-radius: 50%; }
  .p1 { width: 13%; aspect-ratio: 1; right: 4%; bottom: -14%; }
  .p2 { width: 8%; aspect-ratio: 1; right: -8%; bottom: -30%; }
  .stage-pig { position: absolute; right: 8%; bottom: 0; width: 24%; animation: squish 1.4s ease-in-out infinite; transform-origin: 50% 100%; }
  .spark { position: absolute; width: 28px; height: 28px; fill: #fff; stroke: var(--ink); stroke-width: 2; animation: twinkle 2.4s ease-in-out infinite; }
  .s0 { left: 10%; top: 50%; } .s1 { right: 12%; top: 46%; animation-delay: -.6s; } .s2 { left: 40%; top: 0; animation-delay: -1.2s; }
  .s3 { right: 30%; bottom: 6%; animation-delay: -1.8s; } .s4 { left: 30%; bottom: 2%; animation-delay: -.3s; } .s5 { right: 0; top: 60%; animation-delay: -1.5s; }

