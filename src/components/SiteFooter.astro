---
import { Image } from 'astro:assets';
import copy from '../data/copy.json';
import logo from '../assets/ui/logo_catgo.png';
import { PLAY_ICON as playIcon } from './play-icon';

const PLAY = 'https://play.google.com/store/apps/details?id=com.xoproductions.catgo';
const EMAIL = 'xo.labs.production@gmail.com';
---
<footer class="footer">
  <div class="wrap foot-in">
    <Image src={logo} alt="Cat Go!" width={90} />
    <p>{copy.footer.made} · <a href="https://xoproduction.com">xoproduction.com</a></p>
    <nav aria-label="Footer">
      <a href="/privacy-policy">{copy.footer.privacy}</a>
      <a href={`mailto:${EMAIL}`}>{copy.footer.contact}</a>
      <a href={PLAY} rel="noopener">Google Play</a>
    </nav>
    <p class="tiny">© {new Date().getFullYear()} XO Productions. Google Play is a trademark of Google LLC.</p>
  </div>
  <svg class="foot-paws" aria-hidden="true" viewBox="0 0 600 60">
    {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <use href="#paw" x={i * 75} y={i % 2 ? 4 : 26} width="28" height="28" style={`--d:${i * 0.25}s`} />)}
  </svg>
</footer>

<style>
  /* ---------- Footer ---------- */
  .footer { position: relative; background: var(--ink); color: #f5e6cc; padding: 50px 0 80px; overflow: hidden; }
  .foot-in { display: grid; justify-items: center; gap: 14px; text-align: center; }
  .foot-in img { width: 90px; }
  .footer nav { display: flex; gap: 22px; flex-wrap: wrap; justify-content: center; }
  .footer a { color: var(--yellow); font-weight: 800; }
  .tiny { font-size: 13px; opacity: .7; }
  .foot-paws { position: absolute; left: 50%; bottom: 10px; width: 600px; transform: translateX(-50%); fill: rgba(255, 201, 60, .25); }
  .foot-paws use { animation: pawstep 4s ease-in-out infinite; animation-delay: var(--d); opacity: 0; }
  @keyframes pawstep { 10%, 60% { opacity: 1 } 80%, 100% { opacity: 0 } }
</style>
