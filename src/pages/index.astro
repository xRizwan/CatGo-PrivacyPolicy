  .world-copy { padding: 18px 20px 22px; display: grid; gap: 6px; }
  .world-ch { justify-self: start; font: 800 12px/1 var(--body); letter-spacing: .08em; text-transform: uppercase; color: #fff; background: var(--c); border: 3px solid var(--ink); border-radius: 999px; padding: 5px 10px; }
  .world-copy p { color: var(--ink-soft); }
  @media (max-width: 960px) { .world-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .world-list { grid-template-columns: 1fr; } }

  /* ---------- Pets ---------- */
  .pets { background: linear-gradient(#bde8ff, #e9f8ff); border-block: 5px solid var(--ink); overflow: hidden; }
  .flyers { display: grid; grid-template-columns: repeat(4, auto); justify-content: center; align-items: center; gap: 18px 44px; }
  @media (max-width: 600px) { .flyers { grid-template-columns: repeat(2, auto); gap: 14px 24px; } }
  .flyer { width: var(--w); height: 110px; background: var(--sheet) 0 0 / calc(var(--w) * 4) 110px no-repeat; animation: flap .5s steps(4) infinite, float 3.4s ease-in-out infinite; animation-delay: 0s, calc(var(--d) * -1); }
