  @media (max-width: 820px) { .final-card { grid-template-columns: 1fr; text-align: center; justify-items: center; } .final-cat { width: 170px; } .final-boss { display: none; } }


  .step, .world, .mode, .panel, .hero-card { will-change: transform; }
</style>

<script>
  // Power bubble in the hero: 1 -> millions, then again.
  const el = document.querySelector<HTMLElement>('[data-count]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const steps = [1, 3, 7, 15, 42, 120, 380, 1200, 4800, 19000, 86000, 310000, 1200000, 4800000];
    const fmt = (n: number) => (n >= 1e6 ? (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : n >= 1e3 ? Math.round(n / 1e3) + 'K' : String(n));
    let i = 0;
    setInterval(() => {
      i = (i + 1) % steps.length;
      el.textContent = fmt(steps[i]);
      el.animate([{ transform: 'scale(1.35)' }, { transform: 'scale(1)' }], { duration: 280, easing: 'ease-out' });
    }, 650);
  } else if (el) el.textContent = '4.8M';

  // Power climb: the auto-run tells the strip which moment just happened.
  const climbEl = document.querySelector<HTMLElement>('[data-climb]');
  if (climbEl) {
    const moments = [...climbEl.querySelectorAll<HTMLElement>('.moment')];
    moments[0]?.classList.add('on', 'now');
    climbEl.addEventListener('autorun:step', (ev) => {
      const i = (ev as CustomEvent<number>).detail;
      moments.forEach((m, j) => { m.classList.toggle('on', j <= i); m.classList.toggle('now', j === i); });
    });
  }

  // Screenshot strip arrows.
  const strip = document.querySelector<HTMLElement>('[data-strip-el]');
  document.querySelectorAll<HTMLButtonElement>('[data-strip]').forEach((b) =>
    b.addEventListener('click', () => strip?.scrollBy({ left: Number(b.dataset.strip) * Math.min(660, innerWidth * 0.8), behavior: 'smooth' })),
  );
</script>
