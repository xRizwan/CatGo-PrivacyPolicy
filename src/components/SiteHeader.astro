---
import { Image } from 'astro:assets';
import copy from '../data/copy.json';
import logo from '../assets/ui/logo_catgo.png';
import { PLAY_ICON as playIcon } from './play-icon';

const PLAY = 'https://play.google.com/store/apps/details?id=com.xoproductions.catgo';
const EMAIL = 'xo.labs.production@gmail.com';
---
<header class="topbar">
  <div class="wrap topbar-in">
    <a href="/" class="brand" aria-label="Cat Go! home">
      <Image src={logo} alt="Cat Go!" width={86} loading="eager" />
    </a>
    <nav aria-label="Main">
      <a href="/#story">{copy.nav.story}</a>
      <a href="/#how">{copy.nav.how}</a>
      <a href="/#heroes">{copy.nav.heroes}</a>
      <a href="/#worlds">{copy.nav.worlds}</a>
      <a href="/#faq">{copy.nav.faq}</a>
    </nav>
    <a class="play-badge" href={PLAY} rel="noopener" aria-label="Get Cat Go! on Google Play">
      <Fragment set:html={playIcon} />
      <span><small>GET IT ON</small>Google Play</span>
    </a>
  </div>
</header>

<style>
  /* ---------- Header ---------- */
  .topbar { position: sticky; top: 0; z-index: 50; background: rgba(255, 247, 230, .9); backdrop-filter: blur(10px); border-bottom: 4px solid var(--ink); }
  .topbar-in { display: flex; align-items: center; gap: 24px; height: 72px; }
  .brand img { width: 74px; transition: transform .2s; }
  .brand:hover img { transform: rotate(-6deg) scale(1.06); }
  .topbar nav { display: flex; gap: 6px; margin-left: auto; }
  .topbar nav a { text-decoration: none; font-weight: 800; padding: 8px 14px; border-radius: 12px; }
  .topbar nav a:hover { background: var(--cream-2); }
  .play-badge {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px 6px 10px;
    background: #000; color: #fff; text-decoration: none; border: 1px solid #a6a6a6; border-radius: 9px;
    font: 500 19px/1 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; letter-spacing: -.01em; transition: background .15s;
  }
  .play-badge:hover { background: #1f1f1f; }
  .play-badge :global(svg) { width: 24px; height: 24px; flex: none; }
  .play-badge small { display: block; font-size: 9px; letter-spacing: .04em; margin-bottom: 2px; }
  @media (max-width: 820px) { .topbar nav { display: none; } .play-badge { margin-left: auto; } }
</style>
