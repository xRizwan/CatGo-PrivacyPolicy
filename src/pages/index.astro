  .strip-btn { position: absolute; top: 45%; z-index: 2; width: 56px; height: 56px; border-radius: 50%; border: 4px solid var(--ink); background: var(--yellow); box-shadow: 0 5px 0 var(--ink); font: 400 38px/1 var(--display); cursor: pointer; transform: translateY(-50%); padding: 0 0 6px; }
  .strip-btn.prev { left: 14px; } .strip-btn.next { right: 14px; }
  .strip-btn:active { transform: translateY(-46%); box-shadow: 0 2px 0 var(--ink); }
  @media (max-width: 700px) { .strip-btn { display: none; } }

